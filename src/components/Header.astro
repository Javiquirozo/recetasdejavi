---
import Navigation from './Navigation.astro';
---

<header class="print:hidden sticky top-0 z-40 bg-paper/95 dark:bg-night/95 backdrop-blur border-b border-paper-hairline dark:border-night-hairline">
  <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-8 px-5 md:px-[72px] py-4">
    <a href="/" class="flex-shrink-0">
      <img src="/logo-morado.png" alt="Vlog de Javi" class="h-11 md:h-[62px] w-auto object-contain dark:hidden" />
      <img src="/logo-blanco.png" alt="Vlog de Javi" class="hidden dark:block h-11 md:h-[62px] w-auto object-contain" />
    </a>
    <Navigation />
    <button
      onclick="window.toggleDarkMode()"
      class="hidden md:block text-[15px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors flex-shrink-0"
      title="Cambiar modo oscuro"
    >
      ☾
    </button>
  </div>
</header>
