---
import { isRealValue, categoryLabel as getCategoryLabel } from '@/lib/recipeMeta.js';

interface Props {
  titulo: string;
  slug: string;
  categoria: string;
  dificultad?: string;
  tiempo?: string;
  descripcion: string;
  imagenes_locales?: string[];
  porciones?: string;
}

const { titulo, slug, categoria, dificultad, tiempo, descripcion, imagenes_locales, porciones } = Astro.props;
const imagen = imagenes_locales?.[0];
const categoryLabel = getCategoryLabel(categoria);
const url = `${Astro.site}recetas/${slug}`;

const categoryColorClass: Record<string, string> = {
  postre: 'text-aqua-500',
  bebida: 'text-brand-600 dark:text-brand-dark',
  plato_principal: 'text-aqua-500',
  entrada: 'text-lime-500',
  desayuno: 'text-lime-500',
  sopa: 'text-brand-600 dark:text-brand-dark',
  salsa: 'text-aqua-500',
  acompañamiento: 'text-lime-500',
  otros: 'text-paper-muted dark:text-night-muted',
};

const recipeSchema = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": titulo,
  "description": descripcion,
  "image": imagen,
  "recipeCategory": categoryLabel,
  "recipeCuisine": "Vegan",
  "cookTime": tiempo ? `PT${tiempo}` : undefined,
  "author": {
    "@type": "Person",
    "name": "Javi"
  }
};
---

<article class="group" itemscope itemtype="https://schema.org/Recipe">
  <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />

  <a href={`/recetas/${slug}`} class="flex flex-col gap-4 relative">
    <div class="aspect-[4/5] overflow-hidden bg-paper-photo dark:bg-night-surface relative">
      {imagen ? (
        <img
          src={imagen}
          alt={titulo}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          itemprop="image"
        />
      ) : (
        <div class="w-full h-full grid place-items-center">
          <img src="/logo-icono.png" alt="" class="w-14 opacity-20" />
        </div>
      )}
      <button
        type="button"
        class="absolute top-3 left-3 opacity-0 group-hover:opacity-100 transition-opacity w-9 h-9 bg-paper-surface dark:bg-night-surface flex items-center justify-center"
        aria-label="Guardar receta"
        data-recipe={slug}
      >
        <svg class="w-4 h-4 text-paper-ink dark:text-night-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h6a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V5z"></path>
        </svg>
      </button>
    </div>
    <div class="flex flex-col gap-[9px]">
      <span class={`text-[11px] tracking-[0.22em] uppercase font-medium ${categoryColorClass[categoria] || categoryColorClass.otros}`} itemprop="recipeCategory">
        {categoryLabel}
      </span>
      <h3 class="font-display font-medium text-[19px] leading-[1.22] -tracking-[0.01em] text-paper-ink dark:text-night-ink group-hover:text-brand-600 dark:group-hover:text-brand-dark transition-colors line-clamp-2" itemprop="name">
        {titulo}
      </h3>
      {(isRealValue(tiempo) || isRealValue(dificultad)) && (
        <div class="flex gap-4 text-[12.5px] text-paper-muted dark:text-night-muted font-body font-light">
          {isRealValue(tiempo) && <span itemprop="cookTime">{tiempo}</span>}
          {isRealValue(dificultad) && <span>{dificultad}</span>}
        </div>
      )}
    </div>
  </a>
</article>

<script>
  document.querySelectorAll('[data-recipe]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const slug = (e.currentTarget as HTMLElement).getAttribute('data-recipe');
      const saved = JSON.parse(localStorage.getItem('savedRecipes') || '[]');
      if (!saved.includes(slug)) {
        saved.push(slug);
        localStorage.setItem('savedRecipes', JSON.stringify(saved));
        (e.currentTarget as HTMLElement).classList.add('text-brand-600');
      }
    });
  });
</script>
