---
import { isRealRecipe } from '@/lib/recipeMeta.js';

const recipes = await import('@/data/recetas.json').then(m => m.default).then(r => r.filter(isRealRecipe));
const counts = recipes.reduce((acc, r) => {
  if (r.categoria) acc[r.categoria] = (acc[r.categoria] || 0) + 1;
  return acc;
}, {});
const topCategories = Object.entries(counts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([cat]) => cat);
---

<footer class="print:hidden border-t border-paper-hairline dark:border-night-hairline mt-24">
  <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row justify-between items-start gap-10 md:gap-16 px-5 md:px-[72px] py-14 md:py-16">
    <img src="/logo-icono.png" alt="Vlog de Javi" class="h-14 w-auto object-contain opacity-90" />
    <div class="flex flex-wrap gap-12 md:gap-[72px] font-body font-light">
      <div class="flex flex-col gap-[11px]">
        <span class="text-[11px] tracking-[0.22em] uppercase text-paper-muted dark:text-night-muted font-medium">Recetas</span>
        {topCategories.map((cat) => (
          <a href={`/recetas/${cat}`} class="text-[14.5px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors capitalize">
            {cat.replace('_', ' ')}
          </a>
        ))}
      </div>
      <div class="flex flex-col gap-[11px]">
        <span class="text-[11px] tracking-[0.22em] uppercase text-paper-muted dark:text-night-muted font-medium">Más</span>
        <a href="/blog" class="text-[14.5px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors">Blog</a>
        <a href="/recursos" class="text-[14.5px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors">Recursos</a>
        <a href="/sobre-mi" class="text-[14.5px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors">Sobre Javi</a>
      </div>
      <div class="flex flex-col gap-[11px]">
        <span class="text-[11px] tracking-[0.22em] uppercase text-paper-muted dark:text-night-muted font-medium">Sigue</span>
        <a href="https://instagram.com/vlogdejavi" target="_blank" rel="noopener noreferrer" class="text-[14.5px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors">Instagram</a>
      </div>
    </div>
  </div>
  <div class="border-t border-paper-hairline dark:border-night-hairline px-5 md:px-[72px] py-6">
    <p class="text-[13px] text-paper-muted dark:text-night-muted font-body font-light">
      © {new Date().getFullYear()} Vlog de Javi. Todos los derechos reservados.
    </p>
  </div>
</footer>
