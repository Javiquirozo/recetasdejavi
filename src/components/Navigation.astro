---
import { isRealRecipe, categoryLabel } from '@/lib/recipeMeta.js';

const recipes = await import('@/data/recetas.json').then(m => m.default).then(r => r.filter(isRealRecipe));
const categories = [...new Set(recipes.map(r => r.categoria).filter(Boolean))].sort();

const path = Astro.url.pathname;
const isActive = (href) => path === href || (href !== '/' && path.startsWith(href));

const links = [
  { href: '/recetas', label: 'Recetas' },
  { href: '/blog', label: 'Blog' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/sobre-mi', label: 'Sobre Javi' },
];
---

<button id="mobile-menu-btn" class="md:hidden p-2 text-paper-ink dark:text-night-ink flex-shrink-0">
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>

<nav id="nav-menu" class="hidden md:flex gap-[34px] items-center ml-auto font-body font-light">
  {links.map(link => (
    <a
      href={link.href}
      class={`text-[14.5px] transition-colors ${isActive(link.href) ? 'text-brand-600 dark:text-brand-dark' : 'text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark'}`}
    >
      {link.label}
    </a>
  ))}

  <!-- Categorías dropdown -->
  <div class="relative group">
    <button class={`text-[14.5px] transition-colors flex items-center gap-1 ${path.startsWith('/recetas/') ? 'text-brand-600 dark:text-brand-dark' : 'text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark'}`}>
      Categorías
    </button>
    <div class="hidden group-hover:block absolute top-full left-0 mt-2 w-56 bg-paper-surface dark:bg-night-surface border border-paper-hairline dark:border-night-hairline py-2 z-50">
      {categories.map(cat => (
        <a
          href={`/recetas/${cat}`}
          class="block px-4 py-2 text-[14px] text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors"
        >
          {categoryLabel(cat)}
        </a>
      ))}
    </div>
  </div>

  <!-- Search -->
  <div class="flex items-center gap-[9px] border-b border-[#DED5CB] dark:border-night-hairline py-[6px] px-1 min-w-[190px]">
    <span class="text-[14px] text-[#B0A5AB]">⌕</span>
    <input
      id="desktopSearch"
      type="text"
      placeholder="Buscar recetas"
      class="border-none outline-none bg-transparent font-body font-light text-[14px] text-paper-ink dark:text-night-ink placeholder-[#B0A5AB] w-full"
    />
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-x-0 top-[73px] bg-paper dark:bg-night border-b border-paper-hairline dark:border-night-hairline p-5 z-30 flex flex-col gap-4 font-body font-light">
  {links.map(link => (
    <a href={link.href} class="text-[15px] text-paper-ink dark:text-night-ink">{link.label}</a>
  ))}
  {categories.map(cat => (
    <a href={`/recetas/${cat}`} class="text-[14px] text-paper-muted dark:text-night-muted pl-3">{categoryLabel(cat)}</a>
  ))}
  <div class="flex items-center gap-[9px] border-b border-[#DED5CB] py-2">
    <span class="text-[14px] text-[#B0A5AB]">⌕</span>
    <input id="mobileSearch" type="text" placeholder="Buscar recetas" class="border-none outline-none bg-transparent font-body font-light text-[14px] text-paper-ink dark:text-night-ink placeholder-[#B0A5AB] w-full" />
  </div>
  <button onclick="window.toggleDarkMode()" class="text-left text-[14.5px] text-paper-muted dark:text-night-muted">☾ Modo oscuro</button>
</div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopSearch = document.getElementById('desktopSearch');
  const mobileSearch = document.getElementById('mobileSearch');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  [desktopSearch, mobileSearch].forEach((input) => {
    if (input) {
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          const query = input.value.trim();
          if (query) {
            window.location.href = `/recetas?q=${encodeURIComponent(query)}`;
          }
        }
      });
    }
  });
</script>
