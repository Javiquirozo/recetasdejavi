---
const recipes = await import('@/data/recetas.json').then(m => m.default);
const categories = [...new Set(recipes.map(r => r.categoria).filter(Boolean))].sort();

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/blog', label: 'Blog' },
  { href: '/sobre-mi', label: 'Sobre mí' },
];
---

<button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 flex-shrink-0">
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>

<nav id="nav-menu" class="hidden md:flex gap-8 items-center ml-auto">
  {links.map(link => (
    <a
      href={link.href}
      class="font-medium text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-secondary-lime transition-colors"
    >
      {link.label}
    </a>
  ))}

  <!-- Recetas dropdown -->
  <div class="relative group">
    <button class="font-medium text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-secondary-lime transition-colors flex items-center gap-1 py-2">
      Recetas
      <svg class="w-4 h-4 transition-transform duration-200" id="dropdownArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </button>

    <!-- Dropdown menu -->
    <div class="hidden group-hover:block absolute top-full left-0 mt-1 w-56 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 py-2 z-50">
      <a href="/recetas" class="block px-4 py-2 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 font-semibold text-primary transition-colors">
        ✓ Ver todas
      </a>
      <div class="border-t border-gray-200 dark:border-gray-700 my-1"></div>
      {categories.map(cat => (
        <a
          href={`/recetas/${cat}`}
          class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 hover:text-primary transition-colors capitalize"
        >
          {cat.replace('_', ' ')}
        </a>
      ))}
    </div>
  </div>

  <!-- Search icon button -->
  <button id="searchBtn" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 hover:text-primary transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
  </button>
</nav>

<!-- Search input (hidden, appears on top when activated) -->
<div id="searchContainer" class="hidden fixed top-20 left-0 right-0 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 p-4 z-40 md:hidden">
  <input
    id="mobileSearch"
    type="text"
    placeholder="Buscar recetas..."
    class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary"
    autofocus
  />
</div>

<!-- Desktop search input (hidden, shows when clicked) -->
<div id="desktopSearchContainer" class="hidden absolute top-20 left-1/2 transform -translate-x-1/2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-lg p-4 z-40">
  <input
    id="desktopSearch"
    type="text"
    placeholder="Buscar recetas..."
    class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary w-64"
    autofocus
  />
</div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const navMenu = document.getElementById('nav-menu');
  const searchBtn = document.getElementById('searchBtn');
  const searchContainer = document.getElementById('searchContainer');
  const mobileSearch = document.getElementById('mobileSearch');
  const desktopSearchContainer = document.getElementById('desktopSearchContainer');
  const desktopSearch = document.getElementById('desktopSearch');

  // Mobile menu toggle
  if (mobileMenuBtn && navMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      navMenu.classList.toggle('hidden');
    });

    navMenu.querySelectorAll('a:not([id])').forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.add('hidden');
      });
    });
  }

  // Search functionality
  if (searchBtn) {
    searchBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = desktopSearchContainer.classList.contains('hidden');
      if (isHidden) {
        desktopSearchContainer.classList.remove('hidden');
        desktopSearch?.focus();
      } else {
        desktopSearchContainer.classList.add('hidden');
      }
    });
  }

  // Search submit on Enter
  [mobileSearch, desktopSearch].forEach(input => {
    if (input) {
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          const query = input.value.trim();
          if (query) {
            window.location.href = `/recetas?q=${encodeURIComponent(query)}`;
          }
        }
      });
    }
  });

  // Close search when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('#searchBtn') && !e.target.closest('#desktopSearchContainer')) {
      desktopSearchContainer?.classList.add('hidden');
    }
  });

  // Mobile search toggle
  if (searchBtn) {
    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      searchBtn.addEventListener('click', () => {
        searchContainer.classList.toggle('hidden');
        mobileSearch?.focus();
      });
    }
  }
</script>

<style>
  #nav-menu {
    @apply md:flex;
  }

  @media (max-width: 768px) {
    #nav-menu {
      position: fixed;
      top: 80px;
      left: 0;
      width: 100%;
      flex-direction: column;
      background: white;
      padding: 20px;
      gap: 15px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      z-index: 30;
    }

    #nav-menu:not(.hidden) {
      display: flex;
      margin-left: 0;
    }

    :global(.dark) #nav-menu {
      background-color: rgb(17, 24, 39);
    }
  }
</style>
