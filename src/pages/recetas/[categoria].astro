---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import { isRealRecipe, categoryLabel as getCategoryLabel } from '@/lib/recipeMeta.js';

export const prerender = true;

const allRecipes = await import('@/data/recetas.json').then(m => m.default);
const recipes = allRecipes.filter(isRealRecipe);
const categories = [...new Set(recipes.map(r => r.categoria).filter(Boolean))].sort();

export async function getStaticPaths() {
  const { isRealRecipe } = await import('@/lib/recipeMeta.js');
  const allRecipes = await import('@/data/recetas.json').then(m => m.default);
  const categories = [...new Set(allRecipes.filter(isRealRecipe).map(r => r.categoria).filter(Boolean))];

  return categories.map(cat => ({
    params: { categoria: cat }
  }));
}

const { categoria } = Astro.params;
const categoryRecipes = recipes.filter(r => r.categoria === categoria);
const categoryLabel = getCategoryLabel(categoria);
---

<BaseLayout title={`${categoryLabel} — Vlog de Javi`} description={`${categoryRecipes.length} recetas veganas en la categoría ${categoryLabel}`}>
  <Header />

  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-14 flex flex-col gap-7">
    <span class="text-[13px] text-[#A79CA3] font-body font-light">
      <a href="/recetas" class="hover:text-brand-600">Recetas</a> <span class="text-[#DED5CB]">/</span>
      <span class="text-paper-muted dark:text-night-muted">{categoryLabel}</span>
    </span>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
      <div class="flex flex-col gap-3">
        <span class="text-[11px] tracking-[0.22em] uppercase text-paper-muted dark:text-night-muted font-medium">Categoría</span>
        <h1 class="font-display font-medium text-[32px] md:text-[40px] leading-[1.06] -tracking-[0.02em] text-paper-ink dark:text-night-ink">{categoryLabel}</h1>
      </div>
      <span class="text-[13.5px] text-[#A79CA3]">{categoryRecipes.length} recetas</span>
    </div>

    <div class="flex gap-[9px] flex-wrap pb-[26px] border-b border-paper-hairline dark:border-night-hairline">
      <a href="/recetas" class="rounded-full px-[18px] py-[9px] text-[14px] border border-[#DED5CB] dark:border-night-hairline text-paper-muted dark:text-night-muted hover:border-brand-600 hover:text-brand-600 transition-colors">
        Todas
      </a>
      {categories.map(cat => (
        <a
          href={`/recetas/${cat}`}
          class={`rounded-full px-[18px] py-[9px] text-[14px] transition-colors ${cat === categoria ? 'border border-paper-ink bg-paper-ink text-paper dark:border-night-ink dark:bg-night-ink dark:text-night' : 'border border-[#DED5CB] dark:border-night-hairline text-paper-muted dark:text-night-muted hover:border-brand-600 hover:text-brand-600'}`}
        >
          {getCategoryLabel(cat)}
        </a>
      ))}
    </div>
  </div>

  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-11 pb-20 md:pb-[110px]">
    {categoryRecipes.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-10 gap-x-9">
        {categoryRecipes.map(recipe => (
          <RecipeCard
            titulo={recipe.titulo}
            slug={recipe.slug}
            categoria={recipe.categoria}
            dificultad={recipe.dificultad}
            tiempo={recipe.tiempo}
            descripcion={recipe.descripcion}
            imagenes_locales={recipe.imagenes_locales}
          />
        ))}
      </div>
    ) : (
      <div class="flex flex-col items-center gap-[18px] py-24 md:py-[120px] text-center">
        <img src="/logo-icono.png" alt="" class="w-[62px] opacity-[0.18]" />
        <h3 class="font-display font-medium text-[24px] -tracking-[0.01em] text-paper-ink dark:text-night-ink">Todavía no hay recetas acá</h3>
        <p class="text-[16.5px] text-paper-muted dark:text-night-muted max-w-[42ch] leading-[1.65] font-body font-light">
          Explora otra categoría o mira todas las recetas disponibles.
        </p>
      </div>
    )}
  </div>

  <Footer />
</BaseLayout>
