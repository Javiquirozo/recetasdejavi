---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import { isRealValue, isRealRecipe, categoryLabel as getCategoryLabel } from '@/lib/recipeMeta.js';

export const prerender = true;

export async function getStaticPaths() {
  const { isRealRecipe } = await import('@/lib/recipeMeta.js');
  const recipes = await import('@/data/recetas.json').then(m => m.default);
  return recipes.filter(isRealRecipe).map((recipe: any) => ({
    params: { slug: recipe.slug },
  }));
}

const allRecipes = await import('@/data/recetas.json').then(m => m.default);
const recipes = allRecipes.filter(isRealRecipe);
const { slug } = Astro.params;
const recipe = recipes.find(r => r.slug === slug);

if (!recipe) {
  return Astro.redirect('/404');
}

const categoryLabel = getCategoryLabel(recipe.categoria);
const images = recipe.imagenes_locales || [];

const related = recipes
  .filter(r => r.categoria === recipe.categoria && r.slug !== slug)
  .slice(0, 3);
---

<BaseLayout title={`${recipe.titulo} — Vlog de Javi`} description={recipe.descripcion} ogImage={images[0]}>
  <Header />

  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-10 flex flex-col gap-6">
    <span class="text-[13px] text-[#A79CA3] font-body font-light">
      <a href="/recetas" class="hover:text-brand-600">Recetas</a> <span class="text-[#DED5CB]">/</span>
      <a href={`/recetas/${recipe.categoria}`} class="hover:text-brand-600">{categoryLabel}</a> <span class="text-[#DED5CB]">/</span>
      <span class="text-paper-muted dark:text-night-muted">{recipe.titulo}</span>
    </span>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_420px] gap-10 md:gap-14 items-start">
      <div class="flex flex-col gap-3">
        <div class="aspect-square overflow-hidden bg-paper-photo dark:bg-night-surface">
          {images[0] ? (
            <img id="mainImage" src={images[0]} alt={recipe.titulo} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full grid place-items-center">
              <img src="/logo-icono.png" alt="" class="w-16 opacity-20" />
            </div>
          )}
        </div>
        {images.length > 1 && (
          <div class="print:hidden grid grid-cols-4 gap-3">
            {images.slice(0, 4).map((img, i) => (
              <button
                class="thumb aspect-square overflow-hidden bg-paper-photo dark:bg-night-surface"
                style={i === 0 ? 'outline:1px solid #9a659b;outline-offset:-1px' : ''}
                data-img={img}
              >
                <img src={img} alt="" class="w-full h-full object-cover" style={i === 0 ? '' : 'opacity:.85'} />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="flex flex-col gap-5 pt-1">
        <span class="text-[11.5px] tracking-[0.24em] uppercase text-brand-600 dark:text-brand-dark font-medium capitalize">{categoryLabel}</span>
        <h1 class="font-display font-medium text-[30px] md:text-[38px] leading-[1.06] -tracking-[0.02em] text-paper-ink dark:text-night-ink">{recipe.titulo}</h1>
        <p class="text-[17px] leading-[1.7] text-paper-muted dark:text-night-muted">{recipe.descripcion}</p>

        <div class="flex gap-9 py-[22px] border-t border-b border-paper-hairline dark:border-night-hairline">
          {isRealValue(recipe.tiempo) && (
            <div class="flex flex-col gap-[5px]">
              <span class="text-[11px] tracking-[0.2em] uppercase text-paper-muted dark:text-night-muted font-medium">Tiempo</span>
              <span class="text-[16.5px] text-paper-ink dark:text-night-ink">{recipe.tiempo}</span>
            </div>
          )}
          {isRealValue(recipe.dificultad) && (
            <div class="flex flex-col gap-[5px]">
              <span class="text-[11px] tracking-[0.2em] uppercase text-paper-muted dark:text-night-muted font-medium">Dificultad</span>
              <span class="text-[16.5px] text-paper-ink dark:text-night-ink">{recipe.dificultad}</span>
            </div>
          )}
          {isRealValue(recipe.porciones) && (
            <div class="flex flex-col gap-[5px]">
              <span class="text-[11px] tracking-[0.2em] uppercase text-paper-muted dark:text-night-muted font-medium">Porciones</span>
              <span class="text-[16.5px] text-paper-ink dark:text-night-ink">{recipe.porciones}</span>
            </div>
          )}
        </div>

        <div class="print:hidden flex gap-4 items-center flex-wrap">
          <a href="#preparacion" class="border-none bg-brand-600 text-white text-[13px] tracking-[0.14em] uppercase px-7 py-[15px] font-medium hover:bg-brand-700 transition-colors">
            Empezar a cocinar
          </a>
          <button onclick="window.print()" class="text-[13.5px] text-paper-muted dark:text-night-muted border-b border-[#DED5CB] pb-[3px]">Imprimir</button>
          <div class="flex items-center gap-4 ml-1">
            <a
              href={`https://wa.me/?text=${encodeURIComponent(recipe.titulo + ' ' + Astro.url)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartir en WhatsApp"
              title="Compartir en WhatsApp"
              class="text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.447-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.981.999-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.886 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.87 11.87 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
              </svg>
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.toString())}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartir en Facebook"
              title="Compartir en Facebook"
              class="text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18 2h-3a6 6 0 00-6 6v3H7v4h2v8h4v-8h3l1-4h-4V8a1 1 0 011-1h3z"></path>
              </svg>
            </a>
            <a
              href="https://instagram.com/vlogdejavi"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Síguenos en Instagram"
              title="Síguenos en Instagram"
              class="text-paper-muted dark:text-night-muted hover:text-brand-600 dark:hover:text-brand-dark transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="preparacion" class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-16 md:pt-[88px] print:pt-8 grid grid-cols-1 md:grid-cols-[420px_1fr] print:!grid-cols-1 gap-10 md:gap-16 items-start">
    <div class="flex flex-col gap-[22px] bg-paper-surface dark:bg-night-surface border border-paper-hairline dark:border-night-hairline p-7 md:p-[36px_34px]">
      <h2 class="font-display font-medium text-[22px] text-paper-ink dark:text-night-ink">Ingredientes</h2>
      {recipe.ingredientes && recipe.ingredientes.length > 0 ? (
        <div id="ingredientList" class="flex flex-col">
          {recipe.ingredientes.map((ing, i) => (
            <div class="ing-item flex items-center gap-[14px] py-[14px] border-b border-[#F0EAE2] dark:border-night-hairline cursor-pointer" data-i={i}>
              <span class="ing-box w-[18px] h-[18px] border border-[#DED5CB] dark:border-night-hairline flex-shrink-0 grid place-items-center text-white text-[11px]"></span>
              <span class="ing-label text-[16px] text-paper-ink dark:text-night-ink">{ing}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-[14.5px] text-paper-muted dark:text-night-muted leading-[1.6]">
          Los ingredientes de esta receta aún no están disponibles — estamos trabajando en completarlos.
        </p>
      )}
    </div>

    <div class="flex flex-col gap-[34px]">
      <h2 class="font-display font-medium text-[22px] text-paper-ink dark:text-night-ink">Preparación</h2>
      {recipe.preparacion && recipe.preparacion.length > 0 ? (
        <div class="flex flex-col gap-[30px]">
          {recipe.preparacion.map((paso, i) => (
            <div class="grid grid-cols-[52px_1fr] gap-[22px] items-start">
              <span class="font-display font-medium text-[15px] text-brand-600 dark:text-brand-dark pt-[3px]">{String(i + 1).padStart(2, '0')}</span>
              <p class="text-[16.5px] leading-[1.75] text-paper-ink dark:text-night-ink max-w-[66ch]">{paso}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-[14.5px] text-paper-muted dark:text-night-muted leading-[1.6]">
          Los pasos de preparación de esta receta aún no están disponibles — estamos trabajando en completarlos.
        </p>
      )}

      {recipe.notas && recipe.notas.length > 0 && recipe.notas.map((nota) => (
        <div class="bg-[#F4F1EA] dark:bg-night-surface border-l-2 border-lime-500 p-6 max-w-[70ch]">
          <p class="text-[16px] leading-[1.7] text-paper-ink dark:text-night-ink">{nota}</p>
        </div>
      ))}
    </div>
  </div>

  {related.length > 0 && (
    <div class="print:hidden max-w-[1440px] mx-auto px-5 md:px-[72px] pt-20 md:pt-24 pb-20 md:pb-[110px]">
      <div class="flex items-baseline gap-5 mb-10">
        <h2 class="font-display font-medium text-[12px] tracking-[0.24em] uppercase text-[#9a8f95]">Recetas relacionadas</h2>
        <span class="flex-1 h-px bg-paper-hairline dark:bg-night-hairline"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10">
        {related.map(r => (
          <RecipeCard
            titulo={r.titulo}
            slug={r.slug}
            categoria={r.categoria}
            dificultad={r.dificultad}
            tiempo={r.tiempo}
            descripcion={r.descripcion}
            imagenes_locales={r.imagenes_locales}
          />
        ))}
      </div>
    </div>
  )}

  <Footer />
</BaseLayout>

<script>
  const thumbs = document.querySelectorAll('.thumb');
  const mainImage = document.getElementById('mainImage');
  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      if (mainImage) mainImage.src = thumb.dataset.img;
      thumbs.forEach(t => {
        t.style.outline = 'none';
        t.querySelector('img').style.opacity = '.85';
      });
      thumb.style.outline = '1px solid #9a659b';
      thumb.style.outlineOffset = '-1px';
      thumb.querySelector('img').style.opacity = '1';
    });
  });

  document.querySelectorAll('.ing-item').forEach(item => {
    item.addEventListener('click', () => {
      const box = item.querySelector('.ing-box');
      const label = item.querySelector('.ing-label');
      const checked = item.classList.toggle('checked');
      box.style.background = checked ? '#9a659b' : 'transparent';
      box.style.borderColor = checked ? '#9a659b' : '';
      box.textContent = checked ? '✓' : '';
      label.style.color = checked ? '#A79CA3' : '';
      label.style.textDecoration = checked ? 'line-through' : 'none';
    });
  });
</script>
