---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import { isRealRecipe, categoryLabel } from '@/lib/recipeMeta.js';
import { BLOG_POST_SLUGS } from '@/lib/blogPosts.js';

const allRecipes = await import('@/data/recetas.json').then(m => m.default);
const recipes = allRecipes.filter(isRealRecipe);
const withPhotos = recipes.filter(r => r.imagenes_locales?.length > 0);

// Selección curada a mano por buena resolución de foto y estilo del plato terminado
// (ver conversación: se descartaron opciones con thumbnails chicos o fotos de "antes de cocinar").
const heroSlugs = [
  'brownie-de-chocolate-y-betarraga-remolacha',
  'tiramisu-crudivegano',
  'tofu-revuelto-tofu-scramble',
  'budin-de-lentejas-y-vegetales-sin-huevo',
  'strogonoff-de-hongos-y-vegetales',
];
// Para cada una, la foto de mejor resolución encontrada (no siempre es imagenes_locales[0]).
const heroImageOverride = {
  'brownie-de-chocolate-y-betarraga-remolacha': '/images/18BAD47C-A094-4E04-9B47-7B60BA2CCF65.jpeg',
  'tiramisu-crudivegano': '/images/IMG_6285.jpg',
  'tofu-revuelto-tofu-scramble': '/images/IMG_1772-1.jpg',
  'budin-de-lentejas-y-vegetales-sin-huevo': '/images/IMG_1570.jpg',
  'strogonoff-de-hongos-y-vegetales': '/images/IMG_0999.jpg',
};
const heroRecipes = heroSlugs
  .map(slug => recipes.find(r => r.slug === slug))
  .filter(Boolean)
  .map(r => ({ ...r, imagenes_locales: [heroImageOverride[r.slug], ...(r.imagenes_locales || [])] }));

const latestRecipes = withPhotos.filter(r => !heroSlugs.includes(r.slug)).slice(0, 9);

const latestPosts = BLOG_POST_SLUGS
  .map(slug => allRecipes.find(r => r.slug === slug))
  .filter(Boolean)
  .sort((a, b) => new Date(b.fechaPublicacion) - new Date(a.fechaPublicacion))
  .slice(0, 3);

const categoryCounts = recipes.reduce((acc, r) => {
  if (r.categoria) acc[r.categoria] = (acc[r.categoria] || 0) + 1;
  return acc;
}, {});
const sortedCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
// Selección curada a mano por foto de mejor calidad y plato terminado (no fotos de
// antes de cocinar) — se revisaron varias opciones por categoría, ver conversación.
const CATEGORY_IMAGES = {
  plato_principal: '/images/IMG-0457.jpg',
  postre: '/images/IMG-3987.jpg',
  salsa: '/images/IMG-7303.jpg',
  desayuno: '/images/IMG-2036.jpg',
  entrada: '/images/albondigas-de-berenjena.jpg',
  acompañamiento: '/images/IMG_6467.jpg',
  sopa: '/images/IMG_8248.jpg',
};
const categoryImage = (cat) => CATEGORY_IMAGES[cat] || recipes.find(r => r.categoria === cat && r.imagenes_locales?.length > 0)?.imagenes_locales?.[0];

const title = 'Vlog de Javi — Recetas veganas';
const description = 'Recetas veganas deliciosas y nutritivas. Más de 167 recetas para una vida más saludable.';
---

<BaseLayout title={title} description={description}>
  <Header />

  <!-- Hero -->
  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-6">
    <div class="relative h-[420px] md:h-[600px] overflow-hidden bg-paper-photo" id="hero">
      {heroRecipes.map((r, i) => (
        <a href={`/recetas/${r.slug}`} class={`absolute inset-0 transition-opacity duration-[1100ms] ease-in-out hero-slide ${i === 0 ? 'opacity-100' : 'opacity-0'}`} data-index={i}>
          <img src={r.imagenes_locales[0]} alt={r.titulo} class="w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
        </a>
      ))}

      <!-- degradado para que el texto siempre se lea, sea cual sea la foto -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-black/30 pointer-events-none"></div>

      <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6 md:px-16">
        {heroRecipes.map((r, i) => (
          <div class={`hero-caption flex flex-col items-center gap-4 md:gap-5 max-w-[720px] ${i === 0 ? '' : 'hidden'}`} data-index={i}>
            <span class="text-[12px] md:text-[12.5px] tracking-[0.22em] uppercase text-white font-medium bg-black/35 backdrop-blur-sm px-4 py-[7px] rounded-full">{categoryLabel(r.categoria)}</span>
            <h1 class="font-display font-medium text-[30px] md:text-[48px] leading-[1.1] md:leading-[1.06] -tracking-[0.02em] text-white text-balance">{r.titulo}</h1>
            <a href={`/recetas/${r.slug}`} class="text-[12.5px] md:text-[13px] tracking-[0.14em] uppercase text-white border-b border-white/80 pb-1 font-medium mt-1">Ver receta</a>
          </div>
        ))}
      </div>

      <!-- controles desktop: flechas + contador -->
      <div class="hidden md:flex items-center gap-[18px] absolute right-[44px] bottom-[38px]">
        <button class="hero-prev text-[17px] text-white/70 hover:text-white transition-colors" aria-label="Anterior">←</button>
        <span class="text-[12.5px] tracking-[0.14em] text-white/70 hero-counter">{`01 / 0${heroRecipes.length}`}</span>
        <button class="hero-next text-[17px] text-white/70 hover:text-white transition-colors" aria-label="Siguiente">→</button>
      </div>
      <!-- indicador mobile: barritas -->
      <div class="flex md:hidden items-center gap-[6px] absolute left-1/2 -translate-x-1/2 bottom-5">
        {heroRecipes.map((_, dashIndex) => (
          <span class={`hero-dash w-6 h-[2px] ${dashIndex === 0 ? 'bg-white' : 'bg-white/35'}`} data-index={dashIndex}></span>
        ))}
      </div>
    </div>
  </div>

  <!-- Categorías -->
  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-16 md:pt-24">
    <div class="flex items-baseline gap-5 mb-9">
      <h2 class="font-display font-medium text-[12px] tracking-[0.24em] uppercase text-[#9a8f95]">Categorías</h2>
      <span class="flex-1 h-px bg-paper-hairline dark:bg-night-hairline"></span>
      <span class="text-[13px] text-[#9a8f95]">{recipes.length} recetas</span>
    </div>
    <div class="relative">
      <div id="categoryScroll" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {sortedCategories.map(([cat, count]) => (
          <a href={`/recetas/${cat}`} class="flex flex-col gap-[13px] w-[150px] md:w-[180px] flex-shrink-0 snap-start">
            <div class="aspect-square overflow-hidden bg-paper-photo dark:bg-night-surface">
              {categoryImage(cat) && <img src={categoryImage(cat)} alt={categoryLabel(cat)} class="w-full h-full object-cover" loading="lazy" />}
            </div>
            <div class="flex justify-between items-baseline">
              <span class="font-display font-medium text-[15px] text-paper-ink dark:text-night-ink">{categoryLabel(cat)}</span>
              <span class="text-[12.5px] text-paper-muted dark:text-night-muted">{count}</span>
            </div>
          </a>
        ))}
      </div>
      <button id="catPrev" aria-label="Categorías anteriores" class="hidden md:flex items-center justify-center absolute -left-5 top-[64px] md:top-[76px] -translate-y-1/2 w-10 h-10 rounded-full bg-paper-surface dark:bg-night-surface border border-paper-hairline dark:border-night-hairline shadow-sm hover:border-brand-600 transition-colors">←</button>
      <button id="catNext" aria-label="Siguientes categorías" class="hidden md:flex items-center justify-center absolute -right-5 top-[64px] md:top-[76px] -translate-y-1/2 w-10 h-10 rounded-full bg-paper-surface dark:bg-night-surface border border-paper-hairline dark:border-night-hairline shadow-sm hover:border-brand-600 transition-colors">→</button>
    </div>
  </div>

  <!-- Últimas recetas -->
  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-16 md:pt-24 pb-20 md:pb-[110px]">
    <div class="flex items-baseline gap-5 mb-10">
      <h2 class="font-display font-medium text-[12px] tracking-[0.24em] uppercase text-[#9a8f95]">Últimas recetas</h2>
      <span class="flex-1 h-px bg-paper-hairline dark:bg-night-hairline"></span>
      <a href="/recetas" class="text-[13px] text-brand-600 dark:text-brand-dark">Ver todas</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 md:gap-x-10 md:gap-y-[52px]">
      {latestRecipes.map(recipe => (
        <RecipeCard
          titulo={recipe.titulo}
          slug={recipe.slug}
          categoria={recipe.categoria}
          dificultad={recipe.dificultad}
          tiempo={recipe.tiempo}
          descripcion={recipe.descripcion}
          imagenes_locales={recipe.imagenes_locales}
        />
      ))}
    </div>
  </div>

  <!-- Del blog -->
  {latestPosts.length > 0 && (
    <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pb-20 md:pb-[110px]">
      <div class="flex items-baseline gap-5 mb-10">
        <h2 class="font-display font-medium text-[12px] tracking-[0.24em] uppercase text-[#9a8f95]">Del blog</h2>
        <span class="flex-1 h-px bg-paper-hairline dark:bg-night-hairline"></span>
        <a href="/blog" class="text-[13px] text-brand-600 dark:text-brand-dark">Ver todos</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 md:gap-x-10 md:gap-y-[52px]">
        {latestPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="group flex flex-col gap-4">
            <div class="aspect-[4/5] overflow-hidden bg-paper-photo dark:bg-night-surface">
              {post.imagenes_locales?.[0] ? (
                <img
                  src={post.imagenes_locales[0]}
                  alt={post.titulo}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full grid place-items-center">
                  <img src="/logo-icono.png" alt="" class="w-14 opacity-20" />
                </div>
              )}
            </div>
            <div class="flex flex-col gap-[9px]">
              <span class="text-[11px] tracking-[0.22em] uppercase font-medium text-brand-600 dark:text-brand-dark">Blog</span>
              <h3 class="font-display font-medium text-[19px] leading-[1.22] -tracking-[0.01em] text-paper-ink dark:text-night-ink group-hover:text-brand-600 dark:group-hover:text-brand-dark transition-colors line-clamp-2">
                {post.titulo}
              </h3>
              <p class="text-[13px] text-paper-muted dark:text-night-muted font-body font-light line-clamp-2">
                {post.descripcion}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Sobre mí -->
  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pb-20 md:pb-[110px]">
    <div class="bg-paper-photo dark:bg-night-surface flex flex-col sm:flex-row items-center gap-7 sm:gap-10 p-8 md:p-12">
      <div class="w-[120px] h-[120px] md:w-[150px] md:h-[150px] rounded-full overflow-hidden flex-shrink-0">
        <img
          src="/images/javi-avatar.jpg"
          alt="Javiera Quiroz"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col gap-3 text-center sm:text-left">
        <span class="text-[11px] tracking-[0.22em] uppercase text-brand-600 dark:text-brand-dark font-medium">Sobre mí</span>
        <h2 class="font-display font-medium text-[24px] md:text-[28px] leading-[1.15] -tracking-[0.01em] text-paper-ink dark:text-night-ink">Hola, soy Javi 👋</h2>
        <p class="text-[15.5px] leading-[1.65] text-paper-muted dark:text-night-muted font-body font-light max-w-[52ch]">
          Soy chef, creadora de contenido y la persona detrás de Vlog de Javi. Llevo años compartiendo recetas veganas para demostrar que la cocina vegetal puede ser rica, entretenida y accesible.
        </p>
        <a href="/sobre-mi" class="text-[13px] tracking-[0.14em] uppercase text-brand-600 dark:text-brand-dark font-medium mt-1">Conóceme →</a>
      </div>
    </div>
  </div>

  <!-- Recursos gratis -->
  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pb-20 md:pb-[110px]">
    <a href="/recursos" class="group flex flex-col sm:flex-row items-center gap-7 sm:gap-10 bg-brand-600 p-8 md:p-12">
      <div class="flex -space-x-8 flex-shrink-0">
        <div class="w-[90px] h-[120px] md:w-[110px] md:h-[146px] shadow-lg rotate-[-6deg] overflow-hidden bg-paper-photo">
          <img src="/images/cover-plan-de-javi-1.png" alt="" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="w-[90px] h-[120px] md:w-[110px] md:h-[146px] shadow-lg rotate-[4deg] overflow-hidden bg-paper-photo">
          <img src="/images/cover-parrilla-veggie.png" alt="" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
      <div class="flex flex-col gap-3 text-center sm:text-left items-center sm:items-start">
        <span class="text-[11px] tracking-[0.22em] uppercase text-white/80 font-medium">Recursos gratis</span>
        <h2 class="font-display font-medium text-[24px] md:text-[28px] leading-[1.15] -tracking-[0.01em] text-white">Descarga guías PDF gratis</h2>
        <p class="text-[15.5px] leading-[1.65] text-white/85 font-body font-light max-w-[56ch]">
          Guías y recetarios que hice hace un tiempo, pero que siguen 100% vigentes: muchas me las siguen pidiendo. Colaboraron además otras personas del mundo foodie que vale la pena conocer.
        </p>
        <span class="text-[13px] tracking-[0.14em] uppercase text-white border-b border-white/80 pb-1 font-medium mt-1 group-hover:opacity-80 transition-opacity">Ver recursos →</span>
      </div>
    </a>
  </div>

  <Footer />
</BaseLayout>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const captions = document.querySelectorAll('.hero-caption');
  const heroCounter = document.querySelector('.hero-counter');
  const heroDashes = document.querySelectorAll('.hero-dash');
  let current = 0;

  function show(index) {
    slides.forEach((s, i) => {
      s.classList.toggle('opacity-100', i === index);
      s.classList.toggle('opacity-0', i !== index);
    });
    captions.forEach((c, i) => c.classList.toggle('hidden', i !== index));
    heroDashes.forEach((d, i) => {
      d.classList.toggle('bg-white', i === index);
      d.classList.toggle('bg-white/35', i !== index);
    });
    if (heroCounter) heroCounter.textContent = `0${index + 1} / 0${slides.length}`;
    current = index;
  }

  document.querySelectorAll('.hero-prev').forEach(btn => btn.addEventListener('click', (e) => {
    e.preventDefault();
    show((current - 1 + slides.length) % slides.length);
    resetAutoplay();
  }));
  document.querySelectorAll('.hero-next').forEach(btn => btn.addEventListener('click', (e) => {
    e.preventDefault();
    show((current + 1) % slides.length);
    resetAutoplay();
  }));

  let autoplay;
  function resetAutoplay() {
    if (autoplay) clearInterval(autoplay);
    if (slides.length > 1) {
      autoplay = setInterval(() => show((current + 1) % slides.length), 6000);
    }
  }
  resetAutoplay();

  // swipe táctil en mobile
  const hero = document.getElementById('hero');
  let touchStartX = 0;
  let touchStartY = 0;
  let isSwiping = false;

  hero.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    isSwiping = false;
  }, { passive: true });

  hero.addEventListener('touchmove', (e) => {
    const dx = e.touches[0].clientX - touchStartX;
    const dy = e.touches[0].clientY - touchStartY;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) {
      isSwiping = true;
    }
  }, { passive: true });

  hero.addEventListener('touchend', (e) => {
    if (!isSwiping) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    const threshold = 40;
    if (Math.abs(dx) > threshold) {
      if (dx < 0) {
        show((current + 1) % slides.length);
      } else {
        show((current - 1 + slides.length) % slides.length);
      }
      resetAutoplay();
    }
  });

  // evita que un swipe termine navegando a la receta por accidente
  slides.forEach(slide => {
    slide.addEventListener('click', (e) => {
      if (isSwiping) e.preventDefault();
    });
  });

  // Carrusel de categorías
  const categoryScroll = document.getElementById('categoryScroll');
  const catPrev = document.getElementById('catPrev');
  const catNext = document.getElementById('catNext');
  if (categoryScroll && catPrev && catNext) {
    const scrollByCards = (dir) => {
      const card = categoryScroll.querySelector('a');
      const amount = card ? (card.offsetWidth + 24) * 2 : 300;
      categoryScroll.scrollBy({ left: dir * amount, behavior: 'smooth' });
    };
    catPrev.addEventListener('click', () => scrollByCards(-1));
    catNext.addEventListener('click', () => scrollByCards(1));
  }
</script>
