---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout title="Dashboard Admin - Vlog de Javi" description="Panel de administración">
  <Header />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold font-poppins text-gray-900 dark:text-white">
        🍽️ Dashboard Admin
      </h1>
      <button id="logoutBtn" class="bg-red-500 hover:bg-red-600 text-white font-semibold px-4 py-2 rounded-lg">
        Cerrar sesión
      </button>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <button id="newRecipeBtn" class="bg-primary hover:bg-primary/90 text-white font-semibold py-4 rounded-lg flex items-center justify-center gap-2 transition-colors">
        ➕ Nueva Receta
      </button>
      <button id="newBlogBtn" class="bg-secondary-teal hover:bg-secondary-teal/90 text-white font-semibold py-4 rounded-lg flex items-center justify-center gap-2 transition-colors">
        📝 Nuevo Blog Post
      </button>
      <button id="categoriesBtn" class="bg-secondary-lime hover:bg-secondary-lime/90 text-white font-semibold py-4 rounded-lg flex items-center justify-center gap-2 transition-colors">
        🏷️ Gestionar Categorías
      </button>
    </div>

    <!-- Search and Filter -->
    <div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg mb-8">
      <input
        type="text"
        id="searchInput"
        placeholder="Buscar recetas..."
        class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
      />
    </div>

    <!-- Recipes List -->
    <div>
      <h2 class="text-2xl font-bold font-poppins mb-6 text-gray-900 dark:text-white">
        Recetas Recientes
      </h2>
      <div id="recipesList" class="space-y-4">
        <div class="bg-gray-100 dark:bg-gray-700 rounded-lg p-8 text-center">
          <p class="text-gray-600 dark:text-gray-400">Cargando recetas...</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Recipe Modal -->
  <div id="recipeModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full my-8">
      <div class="p-6 max-h-[85vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6 sticky top-0 bg-white dark:bg-gray-800">
          <h2 id="modalTitle" class="text-2xl font-bold font-poppins text-gray-900 dark:text-white">
            Editar Receta
          </h2>
          <button id="closeModal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            ✕
          </button>
        </div>

        <form id="recipeForm" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              Título
            </label>
            <input type="text" id="titulo" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" required />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              Descripción
            </label>
            <textarea id="descripcion" rows="3" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
              Categorías
            </label>
            <div id="categoriesCheckboxes" class="grid grid-cols-2 gap-3">
              <!-- Checkboxes se cargan aquí -->
            </div>
          </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                Dificultad
              </label>
              <select id="dificultad" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary">
                <option value="Fácil">Fácil</option>
                <option value="Intermedio">Intermedio</option>
                <option value="Difícil">Difícil</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                Tiempo
              </label>
              <input type="text" id="tiempo" placeholder="30 minutos" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                Porciones
              </label>
              <input type="text" id="porciones" placeholder="4 porciones" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              Fotos
            </label>
            <input type="file" id="imageInput" accept="image/*" multiple class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
            <div id="imagePreview" class="mt-4 grid grid-cols-3 gap-4"></div>
          </div>

          <div id="loadingMessage" class="hidden text-center py-4">
            <p class="text-gray-600 dark:text-gray-400">Guardando...</p>
          </div>

          <div id="successMessage" class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-3">
            <p class="text-green-800 dark:text-green-200 text-sm">¡Receta guardada exitosamente!</p>
          </div>

          <div class="flex gap-4 pt-6">
            <button type="submit" class="flex-1 bg-primary hover:bg-primary/90 text-white font-semibold py-2 rounded-lg transition-colors">
              Guardar Cambios
            </button>
            <button type="button" id="deleteRecipeBtn" class="flex-1 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 rounded-lg transition-colors hidden">
              Borrar Receta
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <Footer />

  <script>
    import { supabase } from '@/lib/supabase';

    let recipes = [];
    let categories = [];
    let currentRecipeId = null;
    let uploadedImages = [];

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/admin';
    });

    // Check auth
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/admin';
    }

    // Load categories and render checkboxes
    async function loadCategories() {
      try {
        const recipesData = await import('@/data/recetas.json').then(m => m.default);
        categories = [...new Set(recipesData.map(r => r.categoria))].filter(Boolean).sort();

        const container = document.getElementById('categoriesCheckboxes') as HTMLDivElement;
        if (container) {
          container.innerHTML = categories.map(cat => `
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="categoria" value="${cat}" class="w-4 h-4 rounded border-gray-300 dark:border-gray-600" />
              <span class="text-sm text-gray-700 dark:text-gray-300">${cat.replace('_', ' ')}</span>
            </label>
          `).join('');
        }
      } catch (err) {
        console.error('Error loading categories:', err);
      }
    }

    // Load recipes from Supabase
    async function loadRecipes() {
      try {
        const { data, error } = await supabase
          .from('recipes')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) throw error;
        if (data && data.length > 0) {
          recipes = data;
        } else {
          // Fallback to JSON if no recipes in Supabase
          const recipesData = await import('@/data/recetas.json').then(m => m.default);
          recipes = recipesData;
        }
        renderRecipes(recipes);
      } catch (err) {
        console.error('Error loading recipes:', err);
        // Fallback to JSON
        const recipesData = await import('@/data/recetas.json').then(m => m.default);
        recipes = recipesData;
        renderRecipes(recipes);
      }
    }

    function renderRecipes(items) {
      const container = document.getElementById('recipesList');
      if (!container) return;

      if (items.length === 0) {
        container.innerHTML = '<p class="text-gray-600 dark:text-gray-400 p-6">No se encontraron recetas</p>';
        return;
      }

      container.innerHTML = items.map(recipe => `
        <div class="bg-white dark:bg-gray-700 rounded-lg p-4 flex items-center justify-between hover:shadow-md transition-shadow">
          <div class="flex-1">
            <h3 class="font-semibold text-lg text-gray-900 dark:text-white">${recipe.titulo}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">${(recipe.categoria || 'otros').replace('_', ' ')} • ${recipe.dificultad}</p>
          </div>
          <div class="flex gap-2">
            <button class="edit-btn px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90" data-id="${recipe.id || recipe.slug}">
              ✏️ Editar
            </button>
          </div>
        </div>
      `).join('');

      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = e.target.dataset.id;
          const recipe = recipes.find(r => r.id === id || r.slug === id);
          if (recipe) openRecipeModal(recipe);
        });
      });
    }

    function openRecipeModal(recipe) {
      currentRecipeId = recipe.id || recipe.slug;
      uploadedImages = recipe.imagenes_locales || [];
      (document.getElementById('titulo') as HTMLInputElement).value = recipe.titulo;
      (document.getElementById('descripcion') as HTMLTextAreaElement).value = recipe.descripcion || '';
      (document.getElementById('dificultad') as HTMLSelectElement).value = recipe.dificultad || '';
      (document.getElementById('tiempo') as HTMLInputElement).value = recipe.tiempo || '';
      (document.getElementById('porciones') as HTMLInputElement).value = recipe.porciones || '';
      document.getElementById('successMessage')?.classList.add('hidden');

      // Handle categories (can be string or array)
      const recipeCats = Array.isArray(recipe.categoria)
        ? recipe.categoria
        : (recipe.categoria ? recipe.categoria.split(',').map((c: string) => c.trim()) : []);

      // Mark checkboxes
      document.querySelectorAll('input[name="categoria"]').forEach((checkbox: any) => {
        checkbox.checked = recipeCats.includes(checkbox.value);
      });

      renderImagePreview();
      document.getElementById('recipeModal')?.classList.remove('hidden');
      document.getElementById('deleteRecipeBtn')?.classList.remove('hidden');
    }

    function renderImagePreview() {
      const preview = document.getElementById('imagePreview');
      if (!preview) return;

      preview.innerHTML = uploadedImages.map((img, idx) => `
        <div class="relative">
          <img src="${img}" alt="Recipe" class="w-full h-32 object-cover rounded-lg" />
          <button type="button" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center" onclick="removeImage(${idx})">
            ✕
          </button>
        </div>
      `).join('');
    }

    window.removeImage = (idx) => {
      uploadedImages.splice(idx, 1);
      renderImagePreview();
    };

    document.getElementById('imageInput')?.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files) as File[];
      for (const file of files) {
        const formData = new FormData();
        formData.append('file', file);

        try {
          const res = await fetch('/admin/api/upload', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.url) {
            uploadedImages.push(data.url);
            renderImagePreview();
          }
        } catch (err) {
          console.error('Upload error:', err);
          alert('Error al subir imagen: ' + err.message);
        }
      }
    });

    document.getElementById('recipeForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const loading = document.getElementById('loadingMessage');
      const success = document.getElementById('successMessage');
      if (loading) loading.classList.remove('hidden');
      if (success) success.classList.add('hidden');

      try {
        const titulo = (document.getElementById('titulo') as HTMLInputElement).value;

        // Get selected categories
        const selectedCats = Array.from(document.querySelectorAll('input[name="categoria"]:checked'))
          .map((cb: any) => cb.value)
          .join(', ');

        const body = {
          id: currentRecipeId,
          titulo: titulo,
          slug: currentRecipeId || titulo.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, ''),
          descripcion: (document.getElementById('descripcion') as HTMLTextAreaElement).value,
          categoria: selectedCats,
          dificultad: (document.getElementById('dificultad') as HTMLSelectElement).value,
          tiempo: (document.getElementById('tiempo') as HTMLInputElement).value,
          porciones: (document.getElementById('porciones') as HTMLInputElement).value,
          ingredientes: [],
          preparacion: [],
          imagenes_locales: uploadedImages
        };

        console.log('Enviando:', body);
        const res = await fetch('/admin/api/recipes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        const data = await res.json();
        console.log('Respuesta:', res.status, data);

        if (!res.ok) {
          throw new Error(data.error || 'Error al guardar');
        }

        if (success) success.classList.remove('hidden');
        setTimeout(() => {
          document.getElementById('recipeModal')?.classList.add('hidden');
          document.getElementById('recipeForm')?.reset();
          loadRecipes();
        }, 2000);
      } catch (err) {
        console.error('Save error:', err);
        alert('Error: ' + err.message);
      } finally {
        if (loading) loading.classList.add('hidden');
      }
    });

    document.getElementById('closeModal')?.addEventListener('click', () => {
      document.getElementById('recipeModal')?.classList.add('hidden');
      currentRecipeId = null;
      uploadedImages = [];
    });

    document.getElementById('newRecipeBtn')?.addEventListener('click', () => {
      currentRecipeId = null;
      uploadedImages = [];
      document.getElementById('recipeForm')?.reset();
      document.getElementById('successMessage')?.classList.add('hidden');
      document.getElementById('deleteRecipeBtn')?.classList.add('hidden');
      document.getElementById('recipeModal')?.classList.remove('hidden');
    });

    document.getElementById('searchInput')?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      const filtered = recipes.filter(r => r.titulo.toLowerCase().includes(query));
      renderRecipes(filtered);
    });

    loadCategories();
    loadRecipes();
  </script>
</BaseLayout>
