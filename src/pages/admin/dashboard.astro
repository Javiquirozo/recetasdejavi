---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout title="Dashboard Admin - Vlog de Javi" description="Panel de administración">
  <Header />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold font-poppins text-gray-900 dark:text-white">
        🍽️ Dashboard Admin
      </h1>
      <button id="logoutBtn" class="bg-red-500 hover:bg-red-600 text-white font-semibold px-4 py-2 rounded-lg">
        Cerrar sesión
      </button>
    </div>

    <!-- Tabs -->
    <div class="flex gap-4 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="recipesTab" class="tab-btn px-4 py-2 font-semibold text-primary border-b-2 border-primary">
        📖 Recetas
      </button>
      <button id="categoriesTab" class="tab-btn px-4 py-2 font-semibold text-gray-600 dark:text-gray-400 border-b-2 border-transparent hover:text-primary">
        🏷️ Categorías
      </button>
      <button id="blogTab" class="tab-btn px-4 py-2 font-semibold text-gray-600 dark:text-gray-400 border-b-2 border-transparent hover:text-primary">
        📝 Blog Posts
      </button>
    </div>

    <!-- RECIPES TAB -->
    <div id="recipesSection" class="tab-content">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">Recetas</h2>
        <button id="newRecipeBtn" class="bg-primary hover:bg-primary/90 text-white font-semibold px-4 py-2 rounded-lg">
          ➕ Nueva Receta
        </button>
      </div>

      <div class="mb-4">
        <input
          type="text"
          id="searchInput"
          placeholder="Buscar recetas..."
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <div id="recipesList" class="space-y-4">
        <p class="text-gray-600 dark:text-gray-400">Cargando...</p>
      </div>
    </div>

    <!-- CATEGORIES TAB -->
    <div id="categoriesSection" class="tab-content hidden">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">Categorías</h2>
        <button id="newCategoryBtn" class="bg-primary hover:bg-primary/90 text-white font-semibold px-4 py-2 rounded-lg">
          ➕ Nueva Categoría
        </button>
      </div>
      <div id="categoriesList" class="space-y-4">
        <p class="text-gray-600 dark:text-gray-400">Cargando...</p>
      </div>
    </div>

    <!-- BLOG TAB -->
    <div id="blogSection" class="tab-content hidden">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">Blog Posts</h2>
        <button id="newBlogBtn" class="bg-primary hover:bg-primary/90 text-white font-semibold px-4 py-2 rounded-lg">
          ➕ Nuevo Post
        </button>
      </div>
      <div id="blogList" class="space-y-4">
        <p class="text-gray-600 dark:text-gray-400">Cargando...</p>
      </div>
    </div>
  </div>

  <!-- RECIPE MODAL -->
  <div id="recipeModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full my-8">
      <div class="p-6 max-h-[85vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold font-poppins">Editar Receta</h2>
          <button id="closeRecipeModal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400">✕</button>
        </div>

        <form id="recipeForm" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Título</label>
            <input type="text" id="recipeTitle" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" required />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Descripción</label>
            <textarea id="recipeDescription" rows="3" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-3">Categorías</label>
            <div id="categoriesCheckboxes" class="grid grid-cols-2 gap-3">
              <!-- Cargado dinámicamente -->
            </div>
          </div>

          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-semibold mb-2">Dificultad</label>
              <select id="recipeDifficulty" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                <option value="Fácil">Fácil</option>
                <option value="Intermedio">Intermedio</option>
                <option value="Difícil">Difícil</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2">Tiempo</label>
              <input type="text" id="recipeTime" placeholder="30 minutos" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
            </div>
            <div>
              <label class="block text-sm font-semibold mb-2">Porciones</label>
              <input type="text" id="recipePorciones" placeholder="4 porciones" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Fotos</label>
            <input type="file" id="imageInput" accept="image/*" multiple class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
            <div id="imagePreview" class="mt-4 grid grid-cols-3 gap-4"></div>
          </div>

          <div id="successMessage" class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-3">
            <p class="text-green-800 dark:text-green-200 text-sm">✓ ¡Receta guardada!</p>
          </div>

          <div class="flex gap-4">
            <button type="submit" class="flex-1 bg-primary hover:bg-primary/90 text-white font-semibold py-2 rounded-lg">
              Guardar
            </button>
            <button type="button" id="deleteRecipeBtn" class="flex-1 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 rounded-lg hidden">
              Borrar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- CATEGORY MODAL -->
  <div id="categoryModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg max-w-md w-full">
      <div class="p-6">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold font-poppins">Editar Categoría</h2>
          <button id="closeCategoryModal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400">✕</button>
        </div>

        <form id="categoryForm" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Nombre</label>
            <input type="text" id="categoryName" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" required />
          </div>

          <div id="categorySuccessMessage" class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-3">
            <p class="text-green-800 dark:text-green-200 text-sm">✓ ¡Categoría guardada!</p>
          </div>

          <div class="flex gap-4">
            <button type="submit" class="flex-1 bg-primary hover:bg-primary/90 text-white font-semibold py-2 rounded-lg">
              Guardar
            </button>
            <button type="button" id="deleteCategoryBtn" class="flex-1 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 rounded-lg hidden">
              Borrar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- BLOG MODAL -->
  <div id="blogModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full my-8">
      <div class="p-6 max-h-[85vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold font-poppins">Editar Blog Post</h2>
          <button id="closeBlogModal" class="text-gray-500 hover:text-gray-700 dark:text-gray-400">✕</button>
        </div>

        <form id="blogForm" class="space-y-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Título</label>
            <input type="text" id="blogTitle" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" required />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Contenido</label>
            <textarea id="blogContent" rows="6" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white"></textarea>
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Categoría</label>
            <input type="text" id="blogCategory" placeholder="ej: Recetas, Tips, Noticias..." class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
          </div>

          <div>
            <label class="block text-sm font-semibold mb-2">Imagen de portada</label>
            <input type="file" id="blogImageInput" accept="image/*" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
            <img id="blogImagePreviewImg" src="" alt="Preview" class="mt-4 w-full h-32 object-cover rounded-lg hidden" />
          </div>

          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="blogPublished" class="w-4 h-4 rounded border-gray-300 dark:border-gray-600" checked />
            <span class="text-sm text-gray-700 dark:text-gray-300">Publicado</span>
          </label>

          <div id="blogSuccessMessage" class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-3">
            <p class="text-green-800 dark:text-green-200 text-sm">✓ ¡Post guardado!</p>
          </div>

          <div class="flex gap-4">
            <button type="submit" class="flex-1 bg-primary hover:bg-primary/90 text-white font-semibold py-2 rounded-lg">
              Guardar
            </button>
            <button type="button" id="deleteBlogBtn" class="flex-1 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 rounded-lg hidden">
              Borrar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <Footer />

  <script>
    import { supabase } from '@/lib/supabase';

    let recipes = [];
    let categories = [];
    let blogPosts = [];
    let currentRecipeId = null;
    let currentCategoryId = null;
    let currentBlogId = null;
    let uploadedImages = [];
    let uploadedBlogImage = null;

    // Auth check
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/admin';
    }

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/admin';
    });

    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('border-primary', 'text-primary');
          b.classList.add('border-transparent', 'text-gray-600', 'dark:text-gray-400');
        });
        btn.classList.add('border-primary', 'text-primary');
        btn.classList.remove('border-transparent', 'text-gray-600', 'dark:text-gray-400');

        document.querySelectorAll('.tab-content').forEach(section => section.classList.add('hidden'));
        if (btn.id === 'recipesTab') document.getElementById('recipesSection')?.classList.remove('hidden');
        if (btn.id === 'categoriesTab') {
          document.getElementById('categoriesSection')?.classList.remove('hidden');
          loadCategories();
        }
        if (btn.id === 'blogTab') {
          document.getElementById('blogSection')?.classList.remove('hidden');
          loadBlogPosts();
        }
      });
    });

    // Load recipes
    async function loadRecipes() {
      try {
        console.log('🔍 Intentando cargar recetas de Supabase...');
        const { data, error } = await supabase
          .from('recipes')
          .select('*')
          .order('created_at', { ascending: false });

        console.log('Supabase response:', { data, error });
        if (error) throw error;
        if (!data || data.length === 0) {
          throw new Error('No recipes in Supabase');
        }
        console.log('✅ Recetas cargadas de Supabase:', data.length);
        recipes = data;
        renderRecipes(recipes);
      } catch (err) {
        console.log('⚠️ Fallback a JSON:', err);
        try {
          console.log('📄 Leyendo /data/recetas.json...');
          const response = await fetch('/data/recetas.json');
          console.log('Response status:', response.status);
          const recipesData = await response.json();
          console.log('✅ Recetas cargadas de JSON:', recipesData.length);
          recipes = recipesData || [];
          renderRecipes(recipes);
        } catch (jsonErr) {
          console.error('❌ Error al cargar JSON:', jsonErr);
          document.getElementById('recipesList').innerHTML = '<p class="text-red-500">Error: ' + jsonErr.message + '</p>';
        }
      }
    }

    // Load categories
    async function loadCategories() {
      try {
        console.log('📄 Leyendo categorías de /data/recetas.json...');
        const response = await fetch('/data/recetas.json');
        console.log('Response status:', response.status);
        const recipesData = await response.json();
        categories = [...new Set(recipesData.map(r => r.categoria))].filter(Boolean).sort();
        console.log('✅ Categorías cargadas:', categories);

        // Render checkboxes in recipe modal
        const container = document.getElementById('categoriesCheckboxes');
        if (container) {
          container.innerHTML = categories.map(cat => `
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="categoria" value="${cat}" class="w-4 h-4 rounded border-gray-300 dark:border-gray-600" />
              <span class="text-sm text-gray-700 dark:text-gray-300">${cat.replace('_', ' ')}</span>
            </label>
          `).join('');
        }

        renderCategoriesList();
      } catch (err) {
        console.error('❌ Error loading categories:', err);
        document.getElementById('categoriesList').innerHTML = '<p class="text-red-500">Error: ' + err.message + '</p>';
      }
    }

    // Load blog posts
    async function loadBlogPosts() {
      try {
        const { data, error } = await supabase
          .from('blog_posts')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) throw error;
        blogPosts = data || [];
        renderBlogList();
      } catch (err) {
        console.error('Error loading blog:', err);
        document.getElementById('blogList').innerHTML = '<p class="text-gray-600">Error al cargar posts</p>';
      }
    }

    // Render recipes list
    function renderRecipes(items) {
      const container = document.getElementById('recipesList');
      if (!container) return;

      if (items.length === 0) {
        container.innerHTML = '<p class="text-gray-600 dark:text-gray-400">No se encontraron recetas</p>';
        return;
      }

      container.innerHTML = items.map(recipe => `
        <div class="bg-white dark:bg-gray-700 rounded-lg p-4 flex justify-between items-center hover:shadow-md">
          <div class="flex-1">
            <h3 class="font-semibold text-lg">${recipe.titulo}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">${(recipe.categoria || 'otros').replace(/_/g, ' ')} • ${recipe.dificultad}</p>
          </div>
          <button class="edit-recipe-btn px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90" data-id="${recipe.id || recipe.slug}">
            ✏️ Editar
          </button>
        </div>
      `).join('');

      document.querySelectorAll('.edit-recipe-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.target as any).dataset.id;
          const recipe = recipes.find(r => r.id === id || r.slug === id);
          if (recipe) openRecipeModal(recipe);
        });
      });
    }

    // Render categories list
    function renderCategoriesList() {
      const container = document.getElementById('categoriesList');
      if (!container) return;

      if (categories.length === 0) {
        container.innerHTML = '<p class="text-gray-600 dark:text-gray-400">No hay categorías</p>';
        return;
      }

      container.innerHTML = categories.map(cat => `
        <div class="bg-white dark:bg-gray-700 rounded-lg p-4 flex justify-between items-center">
          <span class="font-semibold">${cat.replace('_', ' ')}</span>
          <button class="edit-category-btn px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 text-sm" data-name="${cat}">
            ✏️ Editar
          </button>
        </div>
      `).join('');

      document.querySelectorAll('.edit-category-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const name = (e.target as any).dataset.name;
          openCategoryModal(name);
        });
      });
    }

    // Render blog list
    function renderBlogList() {
      const container = document.getElementById('blogList');
      if (!container) return;

      if (blogPosts.length === 0) {
        container.innerHTML = '<p class="text-gray-600 dark:text-gray-400">No hay posts</p>';
        return;
      }

      container.innerHTML = blogPosts.map(post => `
        <div class="bg-white dark:bg-gray-700 rounded-lg p-4 flex justify-between items-center hover:shadow-md">
          <div class="flex-1">
            <h3 class="font-semibold text-lg">${post.titulo}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">${post.categoria || 'General'} • ${post.publicado ? '📢 Publicado' : '🔒 Borrador'}</p>
          </div>
          <button class="edit-blog-btn px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90" data-id="${post.id}">
            ✏️ Editar
          </button>
        </div>
      `).join('');

      document.querySelectorAll('.edit-blog-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.target as any).dataset.id;
          const post = blogPosts.find(p => p.id === id);
          if (post) openBlogModal(post);
        });
      });
    }

    // Open recipe modal
    function openRecipeModal(recipe: any = null) {
      currentRecipeId = recipe?.id || recipe?.slug || null;
      uploadedImages = recipe?.imagenes_locales || [];

      (document.getElementById('recipeTitle') as HTMLInputElement).value = recipe?.titulo || '';
      (document.getElementById('recipeDescription') as HTMLTextAreaElement).value = recipe?.descripcion || '';
      (document.getElementById('recipeDifficulty') as HTMLSelectElement).value = recipe?.dificultad || 'Fácil';
      (document.getElementById('recipeTime') as HTMLInputElement).value = recipe?.tiempo || '';
      (document.getElementById('recipePorciones') as HTMLInputElement).value = recipe?.porciones || '';

      const recipeCats = recipe?.categoria
        ? (Array.isArray(recipe.categoria) ? recipe.categoria : recipe.categoria.split(',').map((c: string) => c.trim()))
        : [];

      document.querySelectorAll('input[name="categoria"]').forEach((cb: any) => {
        cb.checked = recipeCats.includes(cb.value);
      });

      document.getElementById('successMessage')?.classList.add('hidden');
      renderImagePreview();
      document.getElementById('recipeModal')?.classList.remove('hidden');
      document.getElementById('deleteRecipeBtn')?.classList.toggle('hidden', !recipe);
    }

    // Open category modal
    function openCategoryModal(name: string = '') {
      currentCategoryId = name || null;
      (document.getElementById('categoryName') as HTMLInputElement).value = name.replace('_', ' ');
      document.getElementById('categorySuccessMessage')?.classList.add('hidden');
      document.getElementById('categoryModal')?.classList.remove('hidden');
      document.getElementById('deleteCategoryBtn')?.classList.toggle('hidden', !name);
    }

    // Open blog modal
    function openBlogModal(post: any = null) {
      currentBlogId = post?.id || null;
      uploadedBlogImage = post?.imagen_portada || null;

      (document.getElementById('blogTitle') as HTMLInputElement).value = post?.titulo || '';
      (document.getElementById('blogContent') as HTMLTextAreaElement).value = post?.contenido || '';
      (document.getElementById('blogCategory') as HTMLInputElement).value = post?.categoria || '';
      (document.getElementById('blogPublished') as HTMLInputElement).checked = post?.publicado ?? true;

      if (post?.imagen_portada) {
        const img = document.getElementById('blogImagePreviewImg') as HTMLImageElement;
        img.src = post.imagen_portada;
        img.classList.remove('hidden');
      } else {
        document.getElementById('blogImagePreviewImg')?.classList.add('hidden');
      }

      document.getElementById('blogSuccessMessage')?.classList.add('hidden');
      document.getElementById('blogModal')?.classList.remove('hidden');
      document.getElementById('deleteBlogBtn')?.classList.toggle('hidden', !post);
    }

    // Render image preview
    function renderImagePreview() {
      const preview = document.getElementById('imagePreview');
      if (!preview) return;

      preview.innerHTML = uploadedImages.map((img, idx) => `
        <div class="relative">
          <img src="${img}" alt="Recipe" class="w-full h-32 object-cover rounded-lg" />
          <button type="button" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center hover:bg-red-600" onclick="window.removeImage(${idx})">✕</button>
        </div>
      `).join('');
    }

    window.removeImage = (idx: number) => {
      uploadedImages.splice(idx, 1);
      renderImagePreview();
    };

    // Image upload
    document.getElementById('imageInput')?.addEventListener('change', async (e) => {
      const files = Array.from((e.target as HTMLInputElement).files || []) as File[];
      for (const file of files) {
        const formData = new FormData();
        formData.append('file', file);

        try {
          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.url) {
            uploadedImages.push(data.url);
            renderImagePreview();
          }
        } catch (err) {
          alert('Error al subir: ' + err);
        }
      }
    });

    // Blog image upload
    document.getElementById('blogImageInput')?.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.url) {
          uploadedBlogImage = data.url;
          const img = document.getElementById('blogImagePreviewImg') as HTMLImageElement;
          img.src = uploadedBlogImage;
          img.classList.remove('hidden');
        }
      } catch (err) {
        alert('Error al subir: ' + err);
      }
    });

    // Recipe form submit
    document.getElementById('recipeForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const selectedCats = Array.from(document.querySelectorAll('input[name="categoria"]:checked'))
        .map((cb: any) => cb.value)
        .join(', ');

      const titulo = (document.getElementById('recipeTitle') as HTMLInputElement).value;

      const body = {
        id: currentRecipeId,
        titulo,
        slug: currentRecipeId || titulo.toLowerCase().replace(/\s+/g, '-'),
        descripcion: (document.getElementById('recipeDescription') as HTMLTextAreaElement).value,
        categoria: selectedCats,
        dificultad: (document.getElementById('recipeDifficulty') as HTMLSelectElement).value,
        tiempo: (document.getElementById('recipeTime') as HTMLInputElement).value,
        porciones: (document.getElementById('recipePorciones') as HTMLInputElement).value,
        ingredientes: [],
        preparacion: [],
        imagenes_locales: uploadedImages
      };

      try {
        console.log('📤 Enviando receta:', body);
        const res = await fetch('/api/recipes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        console.log('📥 Response status:', res.status);
        const responseText = await res.text();
        console.log('📥 Response text:', responseText);

        let data;
        try {
          data = JSON.parse(responseText);
        } catch {
          throw new Error(`Invalid JSON response: ${responseText.substring(0, 100)}`);
        }

        if (!res.ok) throw new Error(data.error || 'Error guardando receta');

        console.log('✅ Receta guardada');
        document.getElementById('successMessage')?.classList.remove('hidden');
        setTimeout(() => {
          document.getElementById('recipeModal')?.classList.add('hidden');
          loadRecipes();
        }, 1500);
      } catch (err: any) {
        console.error('❌ Error:', err);
        alert('Error: ' + err.message);
      }
    });

    // Category form submit
    document.getElementById('categoryForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (document.getElementById('categoryName') as HTMLInputElement).value.replace(' ', '_');

      try {
        const res = await fetch('/api/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentCategoryId, name })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        document.getElementById('categorySuccessMessage')?.classList.remove('hidden');
        setTimeout(() => {
          document.getElementById('categoryModal')?.classList.add('hidden');
          loadCategories();
        }, 1500);
      } catch (err: any) {
        alert('Error: ' + err.message);
      }
    });

    // Blog form submit
    document.getElementById('blogForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const titulo = (document.getElementById('blogTitle') as HTMLInputElement).value;

      const body = {
        id: currentBlogId,
        titulo,
        slug: currentBlogId ? undefined : titulo.toLowerCase().replace(/\s+/g, '-'),
        contenido: (document.getElementById('blogContent') as HTMLTextAreaElement).value,
        imagen_portada: uploadedBlogImage,
        categoria: (document.getElementById('blogCategory') as HTMLInputElement).value,
        publicado: (document.getElementById('blogPublished') as HTMLInputElement).checked
      };

      try {
        const res = await fetch('/api/blog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        document.getElementById('blogSuccessMessage')?.classList.remove('hidden');
        setTimeout(() => {
          document.getElementById('blogModal')?.classList.add('hidden');
          loadBlogPosts();
        }, 1500);
      } catch (err: any) {
        alert('Error: ' + err.message);
      }
    });

    // Delete buttons
    document.getElementById('deleteRecipeBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Borrar receta?')) return;
      try {
        const res = await fetch('/api/recipes', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentRecipeId })
        });
        if (!res.ok) throw new Error('Error');
        document.getElementById('recipeModal')?.classList.add('hidden');
        loadRecipes();
      } catch (err) {
        alert('Error al borrar');
      }
    });

    document.getElementById('deleteCategoryBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Borrar categoría?')) return;
      try {
        const res = await fetch('/api/categories', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentCategoryId })
        });
        if (!res.ok) throw new Error('Error');
        document.getElementById('categoryModal')?.classList.add('hidden');
        loadCategories();
      } catch (err) {
        alert('Error al borrar');
      }
    });

    document.getElementById('deleteBlogBtn')?.addEventListener('click', async () => {
      if (!confirm('¿Borrar post?')) return;
      try {
        const res = await fetch('/api/blog', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: currentBlogId })
        });
        if (!res.ok) throw new Error('Error');
        document.getElementById('blogModal')?.classList.add('hidden');
        loadBlogPosts();
      } catch (err) {
        alert('Error al borrar');
      }
    });

    // Close modals
    document.getElementById('closeRecipeModal')?.addEventListener('click', () => {
      document.getElementById('recipeModal')?.classList.add('hidden');
    });

    document.getElementById('closeCategoryModal')?.addEventListener('click', () => {
      document.getElementById('categoryModal')?.classList.add('hidden');
    });

    document.getElementById('closeBlogModal')?.addEventListener('click', () => {
      document.getElementById('blogModal')?.classList.add('hidden');
    });

    // New buttons
    document.getElementById('newRecipeBtn')?.addEventListener('click', () => {
      openRecipeModal();
      (document.getElementById('recipeForm') as HTMLFormElement).reset();
    });

    document.getElementById('newCategoryBtn')?.addEventListener('click', () => {
      openCategoryModal();
      (document.getElementById('categoryForm') as HTMLFormElement).reset();
    });

    document.getElementById('newBlogBtn')?.addEventListener('click', () => {
      openBlogModal();
      (document.getElementById('blogForm') as HTMLFormElement).reset();
    });

    // Search recipes
    document.getElementById('searchInput')?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      const filtered = recipes.filter(r => r.titulo.toLowerCase().includes(query));
      renderRecipes(filtered);
    });

    // Initialize
    await loadCategories();
    await loadRecipes();
  </script>
</BaseLayout>
