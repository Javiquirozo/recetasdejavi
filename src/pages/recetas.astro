---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import { isRealRecipe, categoryLabel } from '@/lib/recipeMeta.js';

const allRecipes = await import('@/data/recetas.json').then(m => m.default);
const recipes = allRecipes.filter(isRealRecipe);
const categories = [...new Set(recipes.map(r => r.categoria).filter(Boolean))].sort();

const initialQuery = Astro.url.searchParams.get('q') || '';
const initialCategory = Astro.url.searchParams.get('categoria') || '';

const title = 'Recetas — Vlog de Javi';
---

<BaseLayout title={title} description={`Explora nuestras ${recipes.length} recetas veganas organizadas por categoría`}>
  <Header />

  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-14 flex flex-col gap-7">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
      <div class="flex flex-col gap-3">
        <span class="text-[11px] tracking-[0.22em] uppercase text-paper-muted dark:text-night-muted font-medium">Todas las recetas</span>
        <h1 class="font-display font-medium text-[32px] md:text-[40px] leading-[1.06] -tracking-[0.02em] text-paper-ink dark:text-night-ink">{recipes.length} recetas veganas</h1>
      </div>
      <span id="resultsCount" class="text-[13.5px] text-[#A79CA3]">Mostrando 1–{Math.min(12, recipes.length)} de {recipes.length}</span>
    </div>

    <div class="mb-2">
      <div class="flex items-center gap-[9px] border-b border-[#DED5CB] dark:border-night-hairline py-[6px] px-1 max-w-md">
        <span class="text-[14px] text-[#B0A5AB]">⌕</span>
        <input
          id="searchInput"
          type="text"
          placeholder="Buscar recetas"
          value={initialQuery}
          class="border-none outline-none bg-transparent font-body font-light text-[14px] text-paper-ink dark:text-night-ink placeholder-[#B0A5AB] w-full"
        />
      </div>
    </div>

    <div id="chips" class="flex gap-[9px] flex-wrap pb-[26px] border-b border-paper-hairline dark:border-night-hairline">
      <button
        data-cat=""
        class:list={["chip", "rounded-full px-[18px] py-[9px] text-[14px] transition-all", initialCategory === "" ? "border border-paper-ink bg-paper-ink text-paper dark:border-night-ink dark:bg-night-ink dark:text-night" : "border border-[#DED5CB] dark:border-night-hairline text-paper-muted dark:text-night-muted"]}
      >
        Todas
      </button>
      {categories.map(cat => (
        <button
          data-cat={cat}
          class:list={["chip", "rounded-full px-[18px] py-[9px] text-[14px] transition-all", initialCategory === cat ? "border border-paper-ink bg-paper-ink text-paper dark:border-night-ink dark:bg-night-ink dark:text-night" : "border border-[#DED5CB] dark:border-night-hairline text-paper-muted dark:text-night-muted"]}
        >
          {categoryLabel(cat)}
        </button>
      ))}
    </div>
  </div>

  <div class="max-w-[1440px] mx-auto px-5 md:px-[72px] pt-11 pb-20 md:pb-[110px]">
    <div id="paginationTop" class="hidden items-center justify-center gap-6 pb-10">
      <button data-page-nav="prev" class="pagination-btn text-[13px] tracking-[0.14em] uppercase text-paper-ink dark:text-night-ink disabled:opacity-30 disabled:cursor-not-allowed">← Anterior</button>
      <span data-page-info class="text-[13.5px] text-[#A79CA3]">Página 1 de 1</span>
      <button data-page-nav="next" class="pagination-btn text-[13px] tracking-[0.14em] uppercase text-paper-ink dark:text-night-ink disabled:opacity-30 disabled:cursor-not-allowed">Siguiente →</button>
    </div>

    <div id="grid" class="grid grid-cols-2 md:grid-cols-4 gap-y-10 gap-x-9">
      {recipes.map(recipe => (
        <div
          class="recipe-item"
          data-titulo={recipe.titulo.toLowerCase()}
          data-descripcion={(recipe.descripcion || '').toLowerCase()}
          data-categoria={recipe.categoria || ''}
        >
          <RecipeCard
            titulo={recipe.titulo}
            slug={recipe.slug}
            categoria={recipe.categoria}
            dificultad={recipe.dificultad}
            tiempo={recipe.tiempo}
            descripcion={recipe.descripcion}
            imagenes_locales={recipe.imagenes_locales}
          />
        </div>
      ))}
    </div>

    <div id="paginationBottom" class="hidden items-center justify-center gap-6 pt-14">
      <button data-page-nav="prev" class="pagination-btn text-[13px] tracking-[0.14em] uppercase text-paper-ink dark:text-night-ink disabled:opacity-30 disabled:cursor-not-allowed">← Anterior</button>
      <span data-page-info class="text-[13.5px] text-[#A79CA3]">Página 1 de 1</span>
      <button data-page-nav="next" class="pagination-btn text-[13px] tracking-[0.14em] uppercase text-paper-ink dark:text-night-ink disabled:opacity-30 disabled:cursor-not-allowed">Siguiente →</button>
    </div>

    <div id="emptyState" class="hidden flex-col items-center gap-[18px] py-24 md:py-[120px] text-center">
      <img src="/logo-icono.png" alt="" class="w-[62px] opacity-[0.18]" />
      <h3 class="font-display font-medium text-[24px] -tracking-[0.01em] text-paper-ink dark:text-night-ink">No encontré nada con eso</h3>
      <p class="text-[16.5px] text-paper-muted dark:text-night-muted max-w-[42ch] leading-[1.65] font-body font-light">
        Prueba con un ingrediente más simple —"garbanzos", "avena"— o mira todas las recetas de la categoría.
      </p>
      <button id="clearAll" class="text-[13px] tracking-[0.14em] uppercase text-paper-ink dark:text-night-ink border-b border-brand-600 pb-[5px] font-medium mt-1">
        Limpiar filtros
      </button>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script define:vars={{ initialCategory }}>
  const searchInput = document.getElementById('searchInput');
  const chips = document.querySelectorAll('.chip');
  const items = document.querySelectorAll('.recipe-item');
  const grid = document.getElementById('grid');
  const emptyState = document.getElementById('emptyState');
  const resultsCount = document.getElementById('resultsCount');
  const clearAll = document.getElementById('clearAll');
  const paginationBars = document.querySelectorAll('#paginationTop, #paginationBottom');
  const pageInfos = document.querySelectorAll('[data-page-info]');
  const prevButtons = document.querySelectorAll('[data-page-nav="prev"]');
  const nextButtons = document.querySelectorAll('[data-page-nav="next"]');

  const PAGE_SIZE = 12;
  let activeCategory = initialCategory;
  let currentPage = 1;

  const activeClasses = ['border-paper-ink', 'bg-paper-ink', 'text-paper', 'dark:border-night-ink', 'dark:bg-night-ink', 'dark:text-night'];
  const inactiveClasses = ['border-[#DED5CB]', 'dark:border-night-hairline', 'text-paper-muted', 'dark:text-night-muted'];

  function setActiveChip() {
    chips.forEach(chip => {
      const isActive = chip.dataset.cat === activeCategory;
      chip.classList.remove('border');
      activeClasses.forEach(c => chip.classList.toggle(c, isActive));
      inactiveClasses.forEach(c => chip.classList.toggle(c, !isActive));
      chip.classList.add('border');
    });
  }

  function getMatches() {
    const q = searchInput.value.trim().toLowerCase();
    return Array.from(items).filter(item => {
      const matchesSearch = !q || item.dataset.titulo.includes(q) || item.dataset.descripcion.includes(q);
      const matchesCategory = !activeCategory || item.dataset.categoria === activeCategory;
      return matchesSearch && matchesCategory;
    });
  }

  function render() {
    const matches = getMatches();
    const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
    currentPage = Math.min(currentPage, totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = new Set(matches.slice(start, start + PAGE_SIZE));

    items.forEach(item => {
      item.classList.toggle('hidden', !pageItems.has(item));
    });

    const rangeEnd = Math.min(matches.length, start + PAGE_SIZE);
    resultsCount.textContent = matches.length > 0
      ? `Mostrando ${start + 1}–${rangeEnd} de ${matches.length}`
      : `Mostrando 0 de ${items.length}`;
    grid.classList.toggle('hidden', matches.length === 0);
    emptyState.classList.toggle('hidden', matches.length > 0);
    emptyState.classList.toggle('flex', matches.length === 0);

    paginationBars.forEach(bar => {
      bar.classList.toggle('hidden', totalPages <= 1);
      bar.classList.toggle('flex', totalPages > 1);
    });
    pageInfos.forEach(el => { el.textContent = `Página ${currentPage} de ${totalPages}`; });
    prevButtons.forEach(btn => { btn.disabled = currentPage <= 1; });
    nextButtons.forEach(btn => { btn.disabled = currentPage >= totalPages; });
  }

  function filter() {
    currentPage = 1;
    render();
  }

  function goToPage(page) {
    currentPage = page;
    render();
    grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  searchInput.addEventListener('input', filter);
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.cat;
      setActiveChip();
      filter();
    });
  });
  clearAll.addEventListener('click', () => {
    searchInput.value = '';
    activeCategory = '';
    setActiveChip();
    filter();
  });
  prevButtons.forEach(btn => btn.addEventListener('click', () => goToPage(currentPage - 1)));
  nextButtons.forEach(btn => btn.addEventListener('click', () => goToPage(currentPage + 1)));

  setActiveChip();
  render();
</script>
