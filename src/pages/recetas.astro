---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import RecipeCard from '@/components/RecipeCard.astro';

const recipes = await import('@/data/recetas.json').then(m => m.default);

const categories = [...new Set(recipes.map(r => r.categoria).filter(Boolean))].sort();
const difficulties = [...new Set(recipes.map(r => r.dificultad))].filter(Boolean).sort();
const title = 'Recetas - Vlog de Javi';
---

<BaseLayout title={title} description="Explora nuestras 167 recetas veganas organizadas por categoría">
  <Header />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="section-title">Nuestras Recetas</h1>

    <!-- Search and Filters -->
    <div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg mb-8">
      <div class="space-y-4">
        <!-- Search -->
        <div>
          <input
            id="searchInput"
            type="text"
            placeholder="Buscar recetas..."
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <!-- Filters -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <select
            id="categoryFilter"
            class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <option value="">Todas las categorías</option>
            {categories.map(cat => cat && (
              <option value={cat}>
                {cat.replace('_', ' ')}
              </option>
            ))}
          </select>

          <select
            id="difficultyFilter"
            class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <option value="">Todas las dificultades</option>
            {difficulties.map(dif => (
              <option value={dif}>
                {dif}
              </option>
            ))}
          </select>

          <button
            id="resetBtn"
            class="btn-primary w-full md:col-span-2 lg:col-span-1"
          >
            Limpiar filtros
          </button>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div>
      <p id="resultsCount" class="text-gray-600 dark:text-gray-400 mb-6">
        Mostrando {recipes.length} recetas
      </p>

      <div id="recipesContainer" class="recipe-grid">
        {recipes.map(recipe => (
          <RecipeCard
            titulo={recipe.titulo}
            slug={recipe.slug}
            categoria={recipe.categoria}
            dificultad={recipe.dificultad}
            tiempo={recipe.tiempo}
            descripcion={recipe.descripcion}
            imagenes_locales={recipe.imagenes_locales}
          />
        ))}
      </div>

      <div id="noResults" class="hidden text-center py-12">
        <p class="text-xl text-gray-600 dark:text-gray-400">
          No se encontraron recetas. Intenta ajustar los filtros.
        </p>
      </div>
    </div>
  </div>

  <script>
    const recipes = {recipes};
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const difficultyFilter = document.getElementById('difficultyFilter');
    const resetBtn = document.getElementById('resetBtn');
    const container = document.getElementById('recipesContainer');
    const noResults = document.getElementById('noResults');
    const resultsCount = document.getElementById('resultsCount');

    function filterRecipes() {
      const search = searchInput.value.toLowerCase();
      const category = categoryFilter.value;
      const difficulty = difficultyFilter.value;

      const filtered = recipes.filter(r => {
        const matchesSearch = !search || r.titulo.toLowerCase().includes(search) || r.descripcion.toLowerCase().includes(search);
        const matchesCategory = !category || r.categoria === category;
        const matchesDifficulty = !difficulty || r.dificultad === difficulty;
        return matchesSearch && matchesCategory && matchesDifficulty;
      });

      container.innerHTML = '';
      const recipesToShow = filtered.slice(0, 24);
      recipesToShow.forEach(recipe => {
        const card = document.createElement('a');
        card.href = `/recetas/${recipe.slug}`;
        card.className = 'card group cursor-pointer';
        card.innerHTML = `
          <div class="w-full h-40 sm:h-48 bg-gray-200 overflow-hidden relative">
            <img src="${recipe.imagenes_locales?.[0] || 'https://via.placeholder.com/400x300?text=' + encodeURIComponent(recipe.titulo)}" alt="${recipe.titulo}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <div class="absolute top-3 right-3 px-3 py-1 rounded-full text-xs font-semibold bg-primary text-white">
              ${recipe.categoria?.replace('_', ' ') || 'otros'}
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-semibold font-poppins text-lg mb-2 line-clamp-2 group-hover:text-primary transition-colors">
              ${recipe.titulo}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2 mb-3">
              ${recipe.descripcion}
            </p>
            <div class="recipe-meta">
              ${recipe.tiempo ? `<span class="flex items-center gap-1"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 11-2 0 1 1 0 012 0zm-1 3a1 1 0 100 2 1 1 0 000-2z"></path></svg>${recipe.tiempo}</span>` : ''}
              ${recipe.dificultad ? `<span class="flex items-center gap-1"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 11-8 0 4 4 0 018 0zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>${recipe.dificultad}</span>` : ''}
            </div>
          </div>
        `;
        container.appendChild(card);
      });

      resultsCount.textContent = `Mostrando ${recipesToShow.length} de ${filtered.length} recetas`;
      noResults.classList.toggle('hidden', filtered.length > 0);
    }

    searchInput.addEventListener('input', filterRecipes);
    categoryFilter.addEventListener('change', filterRecipes);
    difficultyFilter.addEventListener('change', filterRecipes);
    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      categoryFilter.value = '';
      difficultyFilter.value = '';
      filterRecipes();
    });
  </script>

  <Footer />
</BaseLayout>
